# ── Application ───────────────────────────────────────────────────────────────
APP_NAME=IdeaForge
# Comma-separated list of allowed CORS origins (add your Vercel URL here in production)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000
APP_VERSION=0.1.0
DEBUG=false
ENVIRONMENT=development
API_PREFIX=/api/v1

# ── PostgreSQL ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ideaforge

# ── PostgreSQL (test database) ─────────────────────────────────────────────────
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ideaforge_test

# ── Neo4j ─────────────────────────────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password

# ── Redis ──────────────────────────────────────────────────────────────────────
# Used for: LangGraph workflow checkpointing, LLM response caching
REDIS_URL=redis://localhost:6379/0

# ── LLM Providers ─────────────────────────────────────────────────────────────
# Primary: OpenAI — orchestration, complex reasoning, report generation
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Secondary: Google Gemini — generation, evaluation tasks
GOOGLE_API_KEY=AIza...
GEMINI_MODEL=gemini-2.5-flash

# Secondary: Groq — fast inference for scoring and quick classification
GROQ_API_KEY=gsk_...
GROQ_MODEL=llama-3.3-70b-versatile

# ── RAG — document ingestion and vector retrieval (stored in PostgreSQL/pgvector) ─
# Embedding model: text-embedding-3-small is cheap and accurate for retrieval
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Vision model: only invoked when PDF text extraction returns < 100 chars
OPENAI_VISION_MODEL=gpt-4o
# Chunking parameters (characters, approximate)
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=80
# Number of retrieved chunks injected into agent prompts
RAG_TOP_K=5

# ── LangSmith (optional — for workflow tracing) ───────────────────────────────
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false

# ── MCP server (optional — for Claude Desktop integration) ────────────────────
# Run: python backend/mcp_server.py
# Add to ~/.claude_desktop_config.json (see mcp_server.py header for full config)
IDEAFORGE_API_URL=http://localhost:8000/api/v1
